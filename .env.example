DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag
POSTGRES_PASSWORD=postgres
APP_PORT=8000

# hash = offline lexical baseline (default) | openai = semantic embeddings
EMBEDDING_PROVIDER=hash
OPENAI_API_KEY=

# Optional: set to get generated answers from Claude instead of the top passage
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
